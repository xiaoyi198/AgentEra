{
  "providers": {
    "primary": {
      "base_url": "https://api.openai.com/v1",
      "api_key": "在本地填写服务商 API Key",
      "timeout_s": 45,
      "retry_delay_s": 5.0,
      "max_concurrent": 2,
      "queue_interval_s": 1.0
    }
  },
  "models": {
    "fast_tools": {
      "provider": "primary",
      "model": "your-fast-tool-model",
      "capabilities": [
        "tools",
        "json",
        "stream"
      ],
      "max_concurrent": 4,
      "max_retries": 2
    },
    "deep_sim": {
      "provider": "primary",
      "model": "your-reasoning-model",
      "capabilities": [
        "tools",
        "json",
        "long_context",
        "stream"
      ],
      "max_concurrent": 2,
      "max_retries": 2
    }
  },
  "task_policies": {
    "router.simple": [
      "fast_tools"
    ],
    "router.ambiguous": [
      "deep_sim",
      "fast_tools"
    ],
    "agent.turn": [
      "fast_tools",
      "deep_sim"
    ],
    "action.simulation": [
      "deep_sim",
      "fast_tools"
    ],
    "memory.compress": [
      "fast_tools"
    ],
    "tianji.chat": [
      "deep_sim",
      "fast_tools"
    ],
    "default": [
      "fast_tools",
      "deep_sim"
    ]
  },
  "dlc_task_policies": {
    "daming_court": {
      "agent.turn": [
        "fast_tools",
        "deep_sim"
      ],
      "action.simulation": [
        "deep_sim",
        "fast_tools"
      ]
    }
  },
  "agent_task_policies": {
    "daming_court": {
      "example-agent": {
        "agent.turn": [
          "deep_sim",
          "fast_tools"
        ]
      }
    }
  }
}
