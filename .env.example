# Copy to .env or configure these variables in your shell/service environment.
WORLD_SIM_API_KEY=

# Used by config/models.example.json
WORLD_SIM_PRIMARY_API_KEY=

# Optional external OpenAI-compatible API smoke test. The test suite skips it
# unless both values are present. Never commit a real key.
AGENTERA_TEST_BASE_URL=
AGENTERA_TEST_API_KEY=
# Optional: leave blank to auto-select a chat-capable model from /v1/models.
AGENTERA_TEST_MODEL=
AGENTERA_TEST_TIMEOUT_S=90
AGENTERA_TEST_MODEL_ATTEMPTS=3

# Optional authenticated operational metrics endpoints. Keep disabled by default.
WORLD_SIM_ENABLE_METRICS_API=0
WORLD_SIM_METRICS_TOKEN=

# Optional alert thresholds exposed as numeric values only.
WORLD_SIM_ALERT_LLM_ERROR_RATE=0.10
WORLD_SIM_ALERT_LLM_FALLBACK_RATE=0.25
WORLD_SIM_ALERT_DLC_RELOAD_FAILURE_RATE=0.10
WORLD_SIM_ALERT_DLC_RELOAD_MAX_MS=5000
WORLD_SIM_ALERT_WORLD_COMMAND_REJECTION_RATE=0.25
WORLD_SIM_ALERT_AGENT_TURN_ERROR_RATE=0.10
WORLD_SIM_ALERT_ARCHIVE_ISSUES=0
WORLD_SIM_ALERT_BUSY_AGENT_RATIO=0.90

# Optional 32-byte URL-safe Base64 key for encrypted DLC generation archives.
WORLD_SIM_DLC_ARCHIVE_KEY=
