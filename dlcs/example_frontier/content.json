  "actions": [
    {
      "action_id": "frontier_patrol",
      "display_name": "组织边境巡逻",
      "description": "由玩家控制哨站发起巡逻，消耗按统一价值锚计算的银券并提高警戒度。",
      "enabled": true,
      "parameters": [
