  "scenarios": [
    {
      "id": "live-agent-memory-commitment",
      "task": "agent.turn",
      "agent_id": "evaluation-agent",
      "live": {
        "messages": [
          {
            "role": "system",
            "content": "Use tools only. Call recall_memory exactly once with query tax commitment. After the result arrives, call submit_report exactly once. Copy the first returned memory_ids value into commitment_id, set status to resolved, and briefly summarize the evidence. Never invent an identifier or call recall_memory twice."
          },
          {
            "role": "user",
            "content": "Recall the prior tax commitment and submit its evidence-grounded resolved status."
          }
        ],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "recall_memory",
              "description": "Retrieve the bounded structured record for one commitment topic.",
              "parameters": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "enum": [
                      "tax commitment"
                    ]
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              }
            }
          },
          {
            "type": "function",
            "function": {
              "name": "submit_report",
              "description": "Submit the final report using the identifier returned by recall_memory.",
              "parameters": {
                "type": "object",
                "properties": {
                  "commitment_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "resolved",
                      "unresolved"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "commitment_id",
                  "status",
                  "summary"
                ],
                "additionalProperties": false
              }
            }
          }
        ],
        "terminal_tools": [
          "submit_report"
        ],
        "budget": {
          "max_rounds": 3,
          "max_tool_calls": 3,
          "max_tokens": 1600,
          "max_seconds": 45
        },
        "expect": {
          "allowed_tools": [
            "recall_memory",
            "submit_report"
          ],
          "required_tools": [
            "recall_memory",
            "submit_report"
          ],
          "required_tool_sequence": [
            "recall_memory",
            "submit_report"
          ],
          "required_terminal_tool": "submit_report",
          "memory_must_include": [
            "commitment-tax-v1"
          ],
          "commitment_status": "resolved",
          "max_rounds": 2,
          "max_tool_calls": 2,
          "max_tokens": 1600,
          "tool_argument_contracts": [
            {
              "tool": "recall_memory",
              "occurrence": 1,
              "path": "query",
              "equals": "tax commitment"
            },
            {
              "tool": "submit_report",
              "occurrence": 1,
              "path": "commitment_id",
              "equals_tool_result": {
                "tool": "recall_memory",
                "occurrence": 1,
                "path": "memory_ids[0]"
              }
            },
            {
              "tool": "submit_report",
              "occurrence": 1,
              "path": "status",
              "equals": "resolved"
            }
          ]
        },
        "temperature": 0,
        "runtime_fixture": {
          "schema_version": "1.0",
          "memory": {
            "records": [
              {
                "memory_id": "commitment-tax-v1",
                "kind": "commitment",
                "content": "The promised tax commitment report was delivered and acknowledged.",
                "entities": [
                  "tax-office"
                ],
                "importance": 1.0,
                "status": "resolved",
                "metadata": {
                  "topic": "tax_commitment"
                }
              }
            ],
            "retrieval": {
              "limit": 4,
              "max_chars": 1200,
              "unrelated_commitment_limit": 1
            }
          }
        }
      },
      "cohorts": [
        "daming-core"
      ]
    },
